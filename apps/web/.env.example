# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Google Maps (optional progressive enhancement; ride fare calc works without it)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Backend API (DEPRECATED — web reads Supabase directly. Leave unset unless you
# explicitly re-enable NestJS integration. Never point it at localhost in prod.)
# NEXT_PUBLIC_API_URL="https://api.example.com/api/v1"
# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Google Maps (optional progressive enhancement; ride fare calc works without it)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Backend API (DEPRECATED — web reads Supabase directly. Leave unset unless you
# explicitly re-enable NestJS integration. Never point it at localhost in prod.)
# NEXT_PUBLIC_API_URL="https://api.example.com/api/v1"

# ── Site origin (SEO: metadataBase, canonical URLs, sitemap) ────────────────
# Set this on the hosting provider to the production domain, e.g.:
# NEXT_PUBLIC_SITE_URL="https://urbanexplore.com"
# When unset, Vercel deployments fall back to VERCEL_PROJECT_PRODUCTION_URL,
# and local dev falls back to http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=""

# ── Optional: two-instance split ─────────────────────────────────────────
# The app can run as two instances: a main site (consumer + partner surfaces)
# and a separate admin portal (started with ADMIN_PORTAL=1, served on its own
# origin). On a SINGLE hosted deployment leave all three unset — admin routes
# are then served by the same app and the admin layout enforces the
# system_admin role. Localhost values are ignored on purpose (dev-only).
#
# Only set these when you actually run the split:
# NEXT_PUBLIC_MAIN_ORIGIN="https://www.example.com"
# NEXT_PUBLIC_ADMIN_ORIGIN="https://admin.example.com"
# ADMIN_PORTAL="1"   # set on the admin instance only
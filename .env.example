# Database
DATABASE_URL="postgresql://user:password@localhost:5432/urbanexplore?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Supabase JWT Secret
SUPABASE_JWT_SECRET="change-me"

# App
NODE_ENV="development"
PORT=4000
# Admin portal split (optional): main app bounces /dashboard/admin to the portal
# NEXT_PUBLIC_ADMIN_ORIGIN=http://localhost:3001
# NEXT_PUBLIC_MAIN_ORIGIN=http://localhost:3000
# Launch the portal with: powershell -File scripts/dev-admin.ps1
